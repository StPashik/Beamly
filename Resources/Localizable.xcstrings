    "Compatible videos do not need transcoding. External subtitles automatically enable FFmpeg processing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatible videos do not need transcoding. External subtitles automatically enable FFmpeg processing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для совместимого видео перекодирование не требуется. Внешние субтитры включают обработку FFmpeg автоматически."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompatible Videos müssen nicht umgewandelt werden. Externe Untertitel aktivieren automatisch die FFmpeg-Verarbeitung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos compatibles ne nécessitent aucun transcodage. Les sous-titres externes activent automatiquement le traitement FFmpeg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos compatibles no necesitan transcodificación. Los subtítulos externos activan automáticamente el procesamiento con FFmpeg."
          }
        }
      }
    },
