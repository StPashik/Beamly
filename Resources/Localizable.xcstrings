          }
        }
      }
    },
    "This video profile cannot be preserved for Apple TV. Use a supported HEVC Main/Main 10 file, or turn off Preserve video quality for SDR conversion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video profile cannot be preserved for Apple TV. Use a supported HEVC Main/Main 10 file, or turn off Preserve video quality for SDR conversion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот профиль видео нельзя сохранить для Apple TV. Используй совместимый HEVC Main/Main 10 или отключи сохранение качества для преобразования в SDR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Videoprofil kann für Apple TV nicht beibehalten werden. Verwende HEVC Main/Main 10 oder deaktiviere die Beibehaltung der Videoqualität für eine SDR-Konvertierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil vidéo ne peut pas être conservé pour Apple TV. Utilisez HEVC Main/Main 10 ou désactivez la conservation de la qualité pour convertir en SDR."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil de vídeo no puede conservarse para Apple TV. Usa HEVC Main/Main 10 o desactiva la conservación de calidad para convertir a SDR."
          }
        }
      }
    },
    "Bitmap subtitles require video conversion. Choose text subtitles or turn off Preserve video quality.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitmap subtitles require video conversion. Choose text subtitles or turn off Preserve video quality."
