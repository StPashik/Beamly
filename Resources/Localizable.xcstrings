        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Графические субтитры требуют перекодирования видео. Выбери текстовые субтитры или отключи сохранение качества."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
