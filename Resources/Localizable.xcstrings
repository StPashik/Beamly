    "Beamly finds FFmpeg in Homebrew or a selected folder. Without it, compatible MP4/MOV files play via AVFoundation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beamly finds FFmpeg in Homebrew or a selected folder. Without it, compatible MP4/MOV files play via AVFoundation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Beamly находит FFmpeg в Homebrew или выбранной папке. Без него доступны совместимые MP4/MOV через AVFoundation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beamly findet FFmpeg in Homebrew oder einem gewählten Ordner. Ohne FFmpeg werden kompatible MP4/MOV-Dateien über AVFoundation wiedergegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beamly trouve FFmpeg dans Homebrew ou dans le dossier choisi. Sans FFmpeg, les MP4/MOV compatibles sont lus via AVFoundation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Beamly busca FFmpeg en Homebrew o en la carpeta elegida. Sin FFmpeg, los archivos MP4/MOV compatibles se reproducen con AVFoundation."
          }
        }
      }
    },
