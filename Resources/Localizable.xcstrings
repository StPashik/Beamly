    "Dolby Vision remuxing is not supported. Use a compatible MP4 directly or an HDR10/SDR version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Vision remuxing is not supported. Use a compatible MP4 directly or an HDR10/SDR version."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переупаковка Dolby Vision не поддерживается. Используй совместимый MP4 напрямую или версию HDR10/SDR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Vision kann nicht umgepackt werden. Verwende direkt eine kompatible MP4-Datei oder eine HDR10/SDR-Version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
