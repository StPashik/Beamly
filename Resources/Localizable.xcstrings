    "Other formats stream as H.264/AAC at up to 1080p. Software encoding is used if hardware encoding fails.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other formats stream as H.264/AAC at up to 1080p. Software encoding is used if hardware encoding fails."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остальные форматы передаются как H.264/AAC до 1080p. При ошибке аппаратного кодирования используется программное."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Formate werden als H.264/AAC mit bis zu 1080p übertragen. Schlägt die Hardwarekodierung fehl, wird Softwarekodierung verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres formats sont diffusés en H.264/AAC jusqu’à 1080p. L’encodage logiciel prend le relais si l’encodage matériel échoue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás formatos se transmiten en H.264/AAC hasta 1080p. Si falla la codificación por hardware, se usa la codificación por software."
          }
        }
      }
    },
